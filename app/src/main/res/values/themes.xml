<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HuiJuiSU" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      启动图主题。

      core-splashscreen 这个依赖一直在依赖列表里，但从来没人调用 installSplashScreen()，
      冷启动会先闪一下白屏再进 App。这里给一个深色启动图，图标复用自适应图标的前景。
    -->
    <style name="Theme.HuiJuiSU.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.HuiJuiSU</item>
    </style>
</resources>
