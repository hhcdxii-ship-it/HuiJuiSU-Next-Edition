<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标。

  drawable/ 里早就有 ic_hui_background.xml 和 ic_hui_foreground.xml 两个矢量图，
  但从来没有一个 adaptive-icon 去引用它们 —— 等于画好了没用上，
  在部分启动器上图标会被裁成方块或加一圈奇怪的白边。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_hui_background" />
    <foreground android:drawable="@drawable/ic_hui_foreground" />
    <!-- Android 13+ 主题图标：系统会把这一层染色成壁纸主色 -->
    <monochrome android:drawable="@drawable/ic_hui_foreground" />
</adaptive-icon>
